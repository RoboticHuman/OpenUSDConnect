#usda 1.0
(
    defaultPrim = "Teapot"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Scope "MaterialX" (
    references = [
        @./standard_surface_brass_tiled.mtlx@</MaterialX>,
        @../../../assets/test_assets/MaterialXTest/usd_preview_surface_plastic.mtlx@</MaterialX>
    ]
)
{
}

def Xform "Teapot" (
    references = @../../../assets/test_assets/_common/teapot.usda@
)
{
    over "teapot_MeshShape" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </MaterialX/Materials/Tiled_Brass>
    }
}
