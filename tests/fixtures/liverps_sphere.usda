#usda 1.0
(
    defaultPrim = "World"
    doc = """LIVERPS composition test fixture.

    /World/Sphere has:
      - Local opinion: radius = 1.0
      - Variant opinions: size={big: radius=10, small: radius=0.5}
      - Default selection: size=big

    Expected composed radius = 1.0 (Local beats Variant per LIVERPS).

    /World/RefSphere references ref_asset.usda</Model> which sets radius=50.
    It also has a local radius=3.0 opinion.
    Expected composed radius = 3.0 (Local beats Reference).
    """
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Sphere" (
        variants = {
            string size = "big"
        }
        prepend variantSets = "size"
    )
    {
        double radius = 1.0

        variantSet "size" = {
            "big" {
                double radius = 10.0

            }
            "small" {
                double radius = 0.5

            }
        }
    }
}
