// OpenUSDConnect event schema — FlatBuffers IDL
// Covers all event kinds for USD scene synchronization.

namespace OpenUSDConnect;

// ---------------------------------------------------------------------------
// Attribute value — supports scalars and bulk typed arrays (zero-copy)
// ---------------------------------------------------------------------------

// Which field of AttrValue is populated.
enum AttrValueType : byte {
    None = 0,
    ScalarFloat,
    ScalarInt,
    ScalarBool,
    ScalarString,
    FloatArray,     // contiguous float32 — points, normals, UVs (flattened)
    IntArray,       // contiguous int32 — face indices, vertex counts
    StringVal,      // alias for string scalars (kept for clarity)
    NestedList,     // JSON fallback for unusual/nested types
}

table AttrValue {
    value_type:AttrValueType;
    scalar_float:float;
    scalar_int:int;
    scalar_bool:bool;
    scalar_string:string;
    float_array:[float];    // zero-copy bulk path
    int_array:[int];        // zero-copy bulk path
    nested_json:string;     // JSON-encoded fallback for complex types
    stride:ubyte = 1;       // element width: 3 for Vec3f, 2 for Vec2f, 4 for Vec4f
}

// Primvar metadata (USD type name + interpolation)
table PrimvarMeta {
    attr_name:string;
    type_name:string;       // e.g. "float3[]", "texCoord2f[]"
    interpolation:string;   // e.g. "faceVarying", "vertex"
}

// Non-primvar interpolation metadata
table AttrInterp {
    attr_name:string;
    interpolation:string;
}

// Named attribute entry (name + value pair)
table NamedAttr {
    name:string;
    value:AttrValue;
}

// ---------------------------------------------------------------------------
// Composition arc entries
// ---------------------------------------------------------------------------

enum ArcListPosition : byte {
    Explicit,
    Added,
    Prepended,
    Appended,
    Deleted,
    Ordered,
}

table ArcEntry {
    asset_path:string;
    prim_path:string;
    list_position:ArcListPosition = Prepended;
    layer_offset:double;
    layer_scale:double = 1.0;
    // USDA layer fragment whose customLayerData is the reference customData.
    // Empty for payloads and references without custom data.
    custom_data_fragment:string;
}

// One authored sublayer edge. The path remains exactly as authored; each
// process resolves it relative to its own parent layer and resolver context.
table SublayerEntry {
    authored_path:string;
    offset:double;
    scale:double = 1.0;
    layer_key:string;       // empty while the dependency is unresolved
}

// ---------------------------------------------------------------------------
// UsdShade connectable connection / disconnection
// ---------------------------------------------------------------------------

// A connection edge: an attribute on `prim` is connected to an
// attribute on `source_prim`. Names are USD namespace-qualified
// (`inputs:foo` or `outputs:foo`) — the same form that appears in
// .usda syntax. Direction is encoded in the prefix; no separate
// discriminator field. Uniform for input-side and output-side
// connections at any depth.
table Connection {
    local_attr:string;     // attribute on this event's prim
    source_prim:string;    // upstream prim path
    source_attr:string;    // attribute on the upstream prim
}

// ---------------------------------------------------------------------------
// Key-value pair for variant selections and generic string maps
// ---------------------------------------------------------------------------

table StringPair {
    key:string;
    value:string;
}

// ---------------------------------------------------------------------------
// Connectable input value — typed to match UsdShade input types
// ---------------------------------------------------------------------------

// Which field of ConnectableInputValue is populated.
enum ConnectableInputValueType : byte {
    None = 0,
    ScalarFloat,
    ScalarInt,
    ScalarBool,
    ScalarString,
    FloatArray,
    IntArray,
    StringArray,
}

table ConnectableInputValue {
    name:string;
    type_name:string;       // USD type: "float", "color3f", "asset", "matrix4d", "int[]", "token[]", ...
    value_type:ConnectableInputValueType;
    scalar_float:float;
    scalar_int:int;
    scalar_bool:bool;
    scalar_string:string;
    float_array:[float];    // vector types (color3f = 3 floats); matrices flatten row-major
    int_array:[int];
    string_array:[string];
}

// ---------------------------------------------------------------------------
// Event kinds — one table per kind
// ---------------------------------------------------------------------------

table EnsurePrim {
    prim:string;
    type_name:string;       // e.g. "Xform", "Mesh", "Scope"
    api_schemas:[string];   // applied API schemas; multi-apply uses "Name:instance"
}

table EnsureXformOps {
    prim:string;
}

// TRS fields bitmask: bit 0 = translate, bit 1 = rotate, bit 2 = scale
table SetXformTrs {
    prim:string;
    fields:ubyte;           // bitmask: 1=t, 2=r, 4=s
    t:[float];              // 3 floats (translate)
    r:[float];              // 4 floats (quaternion wxyz)
    s:[float];              // 3 floats (scale)
    time:double = null;     // optional time sample; null = default-time
}

table DeletePrim {
    prim:string;
}

table DeactivatePrim {
    prim:string;
    active:bool = true;
}

table RenamePrim {
    prim:string;
    new_name:string;
}

table SetVisibility {
    prim:string;
    visible:bool;
    time:double = null;     // optional time sample; null = default-time
}

table SetGprimAttrs {
    prim:string;
    attrs:[NamedAttr];
    primvar_meta:[PrimvarMeta];
    attr_interp:[AttrInterp];
    time:double = null;     // optional time sample; null = default-time
}

table SetReference {
    prim:string;
    refs:[ArcEntry];
    list_op_authored:bool;
    list_op_explicit:bool;
}

table SetPayload {
    prim:string;
    payloads:[ArcEntry];
    list_op_authored:bool;
    list_op_explicit:bool;
}

table LoadPayload {
    prim:string;
}

table UnloadPayload {
    prim:string;
}

table SetVariantSelections {
    prim:string;
    selections:[StringPair];
}

table SetMaterialBinding {
    prim:string;
    material_path:string;
    material_purpose:string;    // "" = allPurpose; "preview" / "full" select purpose-scoped rels
}

table SetConnectableInput {
    prim:string;
    info_id:string;         // UsdShade `info:id` (Sdr identifier) for Shader prims; empty for NodeGraph/Material/Light
    inputs:[ConnectableInputValue];
    time:double = null;     // optional time sample; null = default-time
}

table SetConnectableConnection {
    prim:string;
    connections:[Connection];
    disconnections:[string];
}

table SetInstanceable {
    prim:string;
    instanceable:bool = true;
}

// PointInstancer fields bitmask (which arrays are present; distinguishes
// "absent" from "explicitly empty", which FB vectors cannot):
// 1=prototypes, 2=proto_indices, 4=positions, 8=orientations, 16=scales,
// 32=velocities, 64=accelerations, 128=angular_velocities, 256=ids,
// 512=invisible_ids, 1024=inactive_ids
table SetPointInstancer {
    prim:string;
    fields:uint;
    prototypes:[string];            // ordered prototype prim paths (rel targets)
    proto_indices:[int];
    positions:[float];              // flattened (N,3)
    orientations:[float];           // flattened (N,4) quaternion wxyz, float32
    scales:[float];                 // flattened (N,3)
    velocities:[float];             // flattened (N,3)
    accelerations:[float];          // flattened (N,3)
    angular_velocities:[float];     // flattened (N,3)
    ids:[long];                     // int64; int32 would truncate sim ids
    invisible_ids:[long];
    time:double = null;             // optional time sample; null = default-time
    inactive_ids:[long];            // resolved inactiveIds prim metadata (uniform)
}

enum SdfSpecKind : byte {
    Layer,
    Prim,
    Attribute,
    Relationship,
    VariantSet,
    Variant,
    Property,
}

// Exact field deltas for authored Sdf specs that specialized events do not
// carry. `spec_path` is the exact path in the authored layer, including
// variant selections. `fragment` is a USDA layer fragment containing the
// declaration and named fields. A named field absent from it is cleared.
// `removed` deletes the spec.
table SetSdfSpecFields {
    prim:string;
    spec_path:string;
    spec_kind:SdfSpecKind;
    fields:[string];
    fragment:string;
    removed:bool = false;
}

// Replace all non-topology opinions in one authored layer. Sublayer paths and
// offsets remain governed by SetSublayers. The fragment is portable USDA
// syntax regardless of the source layer's file format.
table ReplaceSdfLayerContent {
    prim:string;            // always "/"; retained for uniform event routing
    fragment:string;
}

// Replace one layer's complete ordered sublayer list. The parent layer is
// selected by BroadcastEvent.layer_key / Txn.layer_key.
table SetSublayers {
    prim:string;            // always "/"; retained for uniform event routing
    generation:string;
    revision:ulong;         // server-assigned revision for this parent; 0 on client input
    sublayers:[SublayerEntry];
}

// Stage-level metadata (timeCodesPerSecond, framesPerSecond, start/end timecode,
// metersPerUnit, upAxis). Each numeric scalar is a FB-nullable optional —
// absent = "field not authored", present = "apply this value". upAxis is a
// nullable string (None == empty when no opinion).
table SetStageMetadata {
    timeCodesPerSecond:double = null;
    framesPerSecond:double = null;
    startTimeCode:double = null;
    endTimeCode:double = null;
    metersPerUnit:double = null;
    upAxis:string;
}

// ---------------------------------------------------------------------------
// Event union — wraps all event kinds
// ---------------------------------------------------------------------------

union EventPayload {
    EnsurePrim,
    EnsureXformOps,
    SetXformTrs,
    DeletePrim,
    DeactivatePrim,
    RenamePrim,
    SetVisibility,
    SetGprimAttrs,
    SetReference,
    SetPayload,
    LoadPayload,
    UnloadPayload,
    SetVariantSelections,
    SetMaterialBinding,
    SetConnectableInput,
    SetConnectableConnection,
    SetStageMetadata,
    SetInstanceable,
    SetPointInstancer,
    SetSdfSpecFields,
    ReplaceSdfLayerContent,
    SetSublayers,
}

table EventWrapper {
    event:EventPayload;
}
