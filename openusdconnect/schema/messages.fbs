// OpenUSDConnect wire protocol — FlatBuffers schema
// Message envelope with union payload for all message types.

include "events.fbs";

namespace OpenUSDConnect;

// ---------------------------------------------------------------------------
// Message-level types
// ---------------------------------------------------------------------------

table Hello {
    role:string;              // "emitter" or "receiver"
    protocol_version:int;
    sync_from:int;            // sequence number to replay from (receivers)
    client_id:string;
    origin:string;            // session-level id for echo suppression
    department:string;
    token:string;             // TOFU auth token
    layered_replay:bool;      // receiver can reconstruct the logical authored-layer stack
}

table HelloOk {
    token:string;             // issued token (if newly registered)
    stage_metadata:SetStageMetadata;  // snapshot of stage-level metadata (units + timeline)
    layered_replay:bool;      // server accepted logical-layer replay for this receiver
}

table AuthRejected {
    reason:string;
}

enum HelloRejectionCode : ubyte {
    Unspecified = 0,
    LayeredReplayRequired = 1,
}

table HelloRejected {
    code:HelloRejectionCode = Unspecified;
    reason:string;
}

table Txn {
    client_id:string;
    events:[EventWrapper];
    proposal_id:string;       // if set, edits go to this proposal's muted layer, not the live layer
}

table BroadcastEvent {
    seq:int;
    event:EventWrapper;
    origin:string;
    client_id:string;
    client:string;              // address key e.g. "127.0.0.1:1234"
    layer_key:string;           // portable collaboration layer receiving this authored opinion
}

table Resync {}

table Compact {}

table Ping {}

table Quit {}

table CreateProposal {
    target_department:string;
    events:[EventWrapper];
    description:string;
}

table ProposalCreated {
    proposal_id:string;
}

table RateLimited {
    retry_after:float;
}

// ---------------------------------------------------------------------------
// Playback synchronization — single-leader, server-arbitrated
// ---------------------------------------------------------------------------

// Client → server: request the playback-leader role. Server grants if no
// leader is currently set, otherwise rejects. The optional ``time`` is
// the claimer's current timecode — applied as the shared playhead
// atomically with the grant so followers don't snap to a stale value.
table ClaimPlayback {
    client_id:string;
    time:double = null;
}

// Server → claimer: leader role granted. Also broadcast in PlaybackState.
table PlaybackClaimed {
    leader_client_id:string;
}

// Server → claimer (or to a non-leader that tried to drive playback).
table PlaybackRejected {
    reason:string;
    current_leader_client_id:string;
}

// Leader → server: drive the shared playhead. action ∈ {"play","pause","stop","set_time","set_rate"}.
// time / rate are nullable so the decoded dict omits them when the sender
// didn't author one (set_time carries time, set_rate carries rate).
table PlaybackControl {
    action:string;
    time:double = null;
    rate:double = null;
}

// Server → all clients: authoritative playback state snapshot.
table PlaybackState {
    time:double;
    playing:bool;
    rate:double;
    leader_client_id:string;
}

// ---------------------------------------------------------------------------
// Layered replay control
// ---------------------------------------------------------------------------

table LogicalLayerState {
    layer_key:string;
    muted:bool;
    label:string;               // presentation only; never used as identity
}

table LayerStackState {
    generation:string;          // process-local revision domain
    revision:ulong;
    layers:[LogicalLayerState];  // strongest to weakest
}

// ---------------------------------------------------------------------------
// Top-level envelope
// ---------------------------------------------------------------------------

union Payload {
    Hello,
    HelloOk,
    AuthRejected,
    Txn,
    BroadcastEvent,
    Resync,
    Compact,
    Ping,
    Quit,
    CreateProposal,
    ProposalCreated,
    RateLimited,
    ClaimPlayback,
    PlaybackClaimed,
    PlaybackRejected,
    PlaybackControl,
    PlaybackState,
    LayerStackState,
    HelloRejected,
}

table Envelope {
    payload:Payload;
    // Zero means absent/unknown. Encoders always write the current non-zero
    // version so buffers from an incompatible schema cannot inherit a newer
    // generated-code default.
    schema_version:uint16 = 0;
}

root_type Envelope;
