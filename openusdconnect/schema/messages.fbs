// OpenUSDConnect wire protocol — FlatBuffers schema
// Message envelope with union payload for all message types.

include "events.fbs";

namespace OpenUSDConnect;

// ---------------------------------------------------------------------------
// Message-level types
// ---------------------------------------------------------------------------

enum LayerMode : ubyte {
    Managed = 0,
    SharedStage = 1,
}

table Hello {
    role:string;              // "emitter" or "receiver"
    protocol_version:int;
    sync_from:int;            // sequence number to replay from (receivers)
    client_id:string;
    origin:string;            // session-level id for attribution/reconciliation
    department:string;
    token:string;             // TOFU auth token
    layered_replay:bool;      // receiver can reconstruct the logical authored-layer stack
    layer_mode:LayerMode = Managed;
    producer_session_id:string; // emitter identity, bound to this connection
}

table HelloOk {
    token:string;             // issued token (if newly registered)
    stage_metadata:SetStageMetadata;  // snapshot of stage-level metadata (units + timeline)
    layered_replay:bool;      // server accepted logical-layer replay for this receiver
    layer_mode:LayerMode = Managed;
    committed_through:ulong;  // highest durable txn for producer_session_id
}

table AuthRejected {
    reason:string;
}

enum HelloRejectionCode : ubyte {
    Unspecified = 0,
    LayeredReplayRequired = 1,
    LayerModeMismatch = 2,
}

table HelloRejected {
    code:HelloRejectionCode = Unspecified;
    reason:string;
}

table Txn {
    events:[EventWrapper];
    proposal_id:string;       // if set, edits go to this proposal's muted layer, not the live layer
    layer_key:string;         // required for SharedStage transactions
    txn_id:ulong;             // strictly ordered within the Hello-bound producer session
}

enum TransactionStatus : ubyte {
    Acknowledged = 0,
    Rejected = 1,
}

enum TransactionRejectionCode : ubyte {
    None = 0,
    InvalidIdentity = 1,
    UnexpectedId = 2,
    StaleLayerGraph = 3,
    InvalidTransaction = 4,
}

// Server → producer cumulative result. Acknowledged means every transaction
// through txn_id is durable for the session bound during Hello.
table TransactionResult {
    txn_id:ulong;
    status:TransactionStatus = Acknowledged;
    expected_txn_id:ulong;
    rejection_code:TransactionRejectionCode = None;
    reason:string;
}

// Marks the exact replay-to-live boundary for one receiver connection. Every
// replay record through head_seq was sent before this frame while the
// receiver's send lock was held; live broadcasts follow it on the same socket.
table ReplayComplete {
    head_seq:int;
    epoch:ulong;
}

table BroadcastEvent {
    seq:int;
    event:EventWrapper;
    origin:string;
    client_id:string;
    client:string;              // address key e.g. "127.0.0.1:1234"
    layer_key:string;           // portable collaboration layer receiving this authored opinion
}

table Resync {}

table Compact {}

table Ping {}

table Quit {}

table CreateProposal {
    target_department:string;
    events:[EventWrapper];
    description:string;
}

table ProposalCreated {
    proposal_id:string;
}

table RateLimited {
    retry_after:float;
}

// ---------------------------------------------------------------------------
// Playback synchronization — single-leader, server-arbitrated
// ---------------------------------------------------------------------------

// Client → server: request the playback-leader role. Server grants if no
// leader is currently set, otherwise rejects. The optional ``time`` is
// the claimer's current timecode — applied as the shared playhead
// atomically with the grant so followers don't snap to a stale value.
table ClaimPlayback {
    client_id:string;
    time:double = null;
}

// Server → claimer: leader role granted. Also broadcast in PlaybackState.
table PlaybackClaimed {
    leader_client_id:string;
}

// Server → claimer (or to a non-leader that tried to drive playback).
table PlaybackRejected {
    reason:string;
    current_leader_client_id:string;
}

// Leader → server: drive the shared playhead. action ∈ {"play","pause","stop","set_time","set_rate"}.
// time / rate are nullable so the decoded dict omits them when the sender
// didn't author one (set_time carries time, set_rate carries rate).
table PlaybackControl {
    action:string;
    time:double = null;
    rate:double = null;
}

// Server → all clients: authoritative playback state snapshot.
table PlaybackState {
    time:double;
    playing:bool;
    rate:double;
    leader_client_id:string;
}

// ---------------------------------------------------------------------------
// Layered replay control
// ---------------------------------------------------------------------------

table LogicalLayerState {
    layer_key:string;
    muted:bool;
    label:string;               // presentation only; never used as identity
}

table LayerStackState {
    generation:string;          // process-local revision domain
    revision:ulong;
    layers:[LogicalLayerState];  // strongest to weakest
}

// Complete reachable root-layer graph. This is a sequenced replay baseline;
// ordinary edits use SetSublayers for only the changed parent layer.
table SharedLayerState {
    layer_key:string;
    sublayers:[SublayerEntry];
}

table LayerGraphState {
    seq:int;
    generation:string;
    revision:ulong;
    root_layer_key:string;
    layers:[SharedLayerState];
}

// ---------------------------------------------------------------------------
// Top-level envelope
// ---------------------------------------------------------------------------

union Payload {
    Hello,
    HelloOk,
    AuthRejected,
    Txn,
    BroadcastEvent,
    Resync,
    Compact,
    Ping,
    Quit,
    CreateProposal,
    ProposalCreated,
    RateLimited,
    ClaimPlayback,
    PlaybackClaimed,
    PlaybackRejected,
    PlaybackControl,
    PlaybackState,
    LayerStackState,
    HelloRejected,
    LayerGraphState,
    TransactionResult,
    ReplayComplete,
}

table Envelope {
    payload:Payload;
    // Zero means absent/unknown. Encoders always write the current non-zero
    // version so buffers from an incompatible schema cannot inherit a newer
    // generated-code default.
    schema_version:uint16 = 0;
}

root_type Envelope;
