# Unreal build artefacts never commit
Binaries/
Intermediate/
DerivedDataCache/
Saved/

# FlatBuffers runtime headers fetched by setup_flatbuffers.py (version pinned
# to the committed flatc-generated bindings under Public/Schema)
Source/*/ThirdParty/flatbuffers/

# native/client_core sources the Unreal harness stages before BuildPlugin
Source/OpenUSDConnectClientCore/include/
Source/OpenUSDConnectClientCore/src/

# Visual Studio user files (in case someone runs GenerateProjectFiles from this dir)
*.suo
*.user
*.vcxproj
*.vcxproj.filters
*.sln
.vs/
